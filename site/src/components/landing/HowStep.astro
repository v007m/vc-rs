---
/** One numbered step of "How it works"; place inside `<Grid as="ol" columns={3}>`. */
interface Props {
  n: number;
  title: string;
  href: string;
  link: string;
}

const { n, title, href, link } = Astro.props;
---

<li class="lp-step" data-reveal>
  <span class="lp-step-n" aria-hidden="true">{n}</span>
  <h3 class="lp-step-title" set:html={title} />
  <div class="lp-step-body"><slot /></div>
  <a class="lp-step-link" href={href}>{link} <span aria-hidden="true">→</span></a>
</li>

<style>
  .lp-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--lp-border);
    border-radius: 1rem;
    background: var(--lp-card);
  }
  .lp-step-n {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--lp-accent-solid);
    color: #fff;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }
  .lp-step-title {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-xl);
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .lp-step-title :global(code) {
    font-family: var(--__sl-font-mono);
    font-size: 0.9em;
    padding: 0;
    background: none;
    color: var(--sl-color-text-accent);
  }
  .lp-step-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .lp-step-body > :global(*) {
    margin: 0;
  }
  .lp-step-body :global(.expressive-code) {
    --ec-codeFontSize: 0.75rem;
    margin-top: auto;
  }
  .lp-step-body :global(p code) {
    font-family: var(--__sl-font-mono);
    font-size: 0.9em;
    padding: 0.05em 0.3em;
    border-radius: 0.3em;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-gray-1);
    overflow-wrap: anywhere;
  }
  .lp-step-link {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  .lp-step-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
