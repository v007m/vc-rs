---
/** One landing-page section: an eyebrow, a heading, an optional lead and the content. */
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---

<section class="lp-section not-content" aria-labelledby={id}>
  <header class="lp-section-head" data-reveal>
    <p class="lp-eyebrow">{eyebrow}</p>
    <h2 id={id} set:html={title} />
    {lead && <p class="lp-lead" set:html={lead} />}
  </header>
  <slot />
</section>

<style>
  .lp-section {
    padding-block: clamp(3rem, 2.25rem + 3.5vw, 5.5rem);
  }
  .lp-section-head {
    max-width: 42rem;
    margin: 0 auto clamp(2rem, 1.5rem + 2vw, 3.25rem);
    text-align: center;
  }
  .lp-eyebrow {
    margin: 0;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
  }
  h2 {
    margin: 0.75rem 0 0;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .lp-lead {
    margin: 1rem 0 0;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .lp-lead :global(code),
  h2 :global(code) {
    font-family: var(--__sl-font-mono);
    font-size: 0.9em;
  }
</style>
