---
/** One landing-page section: an eyebrow, a heading, an optional lead and the content. */
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  /** `band` paints a full-width tinted background behind the section. */
  variant?: 'plain' | 'band';
}

const { id, eyebrow, title, lead, variant = 'plain' } = Astro.props;
---

<section class:list={['lp-section', 'not-content', { 'lp-band': variant === 'band' }]} aria-labelledby={id}>
  <header class="lp-section-head">
    <p class="lp-eyebrow">{eyebrow}</p>
    <h2 id={id} set:html={title} />
    {lead && <p class="lp-lead" set:html={lead} />}
  </header>
  <slot />
</section>

<style>
  .lp-section {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
  }
  .lp-band::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 calc(50% - 50vw);
    background: var(--lp-band);
    border-block: 1px solid var(--lp-border-soft);
  }
  .lp-section-head {
    max-width: 42rem;
    margin: 0 auto clamp(2rem, 1.5rem + 2vw, 3.25rem);
    text-align: center;
  }
  .lp-eyebrow {
    margin: 0;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
  }
  h2 {
    margin: 0.75rem 0 0;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .lp-lead {
    margin: 1rem 0 0;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .lp-lead :global(code),
  h2 :global(code) {
    font-family: var(--__sl-font-mono);
    font-size: 0.9em;
  }
</style>
