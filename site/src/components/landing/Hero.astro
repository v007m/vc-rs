---
/**
 * Replaces Starlight's `Hero` (only the landing page has `hero:` frontmatter). The title, tagline
 * and actions still come from that frontmatter; the install command and the terminal session are
 * the ones the install page and the quickstart show.
 */
import { Icon } from '@astrojs/starlight/components';
import LineIcon from './LineIcon.astro';
import Terminal from './Terminal.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const install = 'cargo install --git https://github.com/v007m/vc-rs vc-cli vc-demo --locked';

/** Copied from the quickstart's `vc check` and `vc run` steps. */
const session = [
  '$ vc check',
  '0 errors · 0 warnings · 3 files checked',
  '$ vc run',
  'plan  4 tests in 1 file · lifecycle: beforeAll command · profile default',
  '',
  '✓ sample.basics#listsUsers                                        5ms',
  '✓ sample.basics#createsUser                                       5ms',
  '✓ sample.basics#rejectsMissingEmail                               5ms',
  '✓ sample.basics#getsCreatedUser                                   8ms',
  '',
  '4 passed                                                     90ms · profile default',
  'reports  /home/you/shop/.vibranium/reports/1/{ctrf.json,junit.xml,index.html}',
];
---

<section class="lp-hero not-content">
  <div class="lp-glow" aria-hidden="true"></div>
  <a class="lp-pill" href={`${base}/start/concepts/`}>
    <span class="lp-pill-tag">YAML</span>
    <span>Functional, contract and load tests in one engine</span>
    <LineIcon name="arrow" class="lp-pill-arrow" />
  </a>
  <h1 id="_top" data-page-title set:html={title} />
  {tagline && <p class="lp-tagline" set:html={tagline} />}
  {
    actions.length > 0 && (
      <div class="lp-actions">
        {actions.map(({ text, link, variant, icon, attrs }) => (
          <a class:list={['lp-btn', `lp-btn-${variant}`]} href={link} {...attrs}>
            {icon?.type === 'icon' && variant !== 'primary' && <Icon name={icon.name} size="1.15rem" />}
            {text}
            {variant === 'primary' && <LineIcon name="arrow" class="lp-btn-arrow" />}
          </a>
        ))}
      </div>
    )
  }
  <div class="lp-install">
    <code><span class="lp-install-prompt" aria-hidden="true">$</span>{install}</code>
    <button type="button" class="lp-copy" data-copy={install} aria-label="Copy the install command">
      <LineIcon name="copy" class="lp-copy-idle" />
      <LineIcon name="done" class="lp-copy-done" />
    </button>
  </div>
  <p class="lp-install-note">
    Builds <code>vc</code> and the demo service from source with Cargo (Rust 1.99+). Prebuilt releases are planned.
  </p>
  <div class="lp-term">
    <Terminal title="~/shop" lines={session} />
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.lp-copy')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.dataset.copied = '';
        button.setAttribute('aria-label', 'Copied');
        setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute('aria-label', 'Copy the install command');
        }, 1600);
      } catch {
        button.setAttribute('aria-label', 'Copy failed; select the command instead');
      }
    });
  }
</script>

<style>
  .lp-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(2.5rem, 2rem + 5vw, 6rem) 1rem;
    isolation: isolate;
  }
  .lp-glow {
    position: absolute;
    z-index: -1;
    inset: -6rem calc(50% - 50vw) auto;
    height: 46rem;
    pointer-events: none;
    background:
      radial-gradient(40rem 22rem at 50% 18%, var(--lp-glow-1), transparent 70%),
      radial-gradient(28rem 18rem at 22% 40%, var(--lp-glow-2), transparent 70%),
      radial-gradient(28rem 18rem at 80% 36%, var(--lp-glow-3), transparent 70%);
  }
  .lp-glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--lp-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--lp-grid) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 30%, #000 20%, transparent 75%);
  }

  .lp-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    padding: 0.3rem 0.85rem 0.3rem 0.35rem;
    border: 1px solid var(--lp-border);
    border-radius: 999px;
    background: var(--lp-surface);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.3;
    text-decoration: none;
    backdrop-filter: blur(6px);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .lp-pill:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .lp-pill-tag {
    flex: none;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--lp-accent-solid);
    color: #fff;
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .lp-pill :global(.lp-pill-arrow) {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
  }

  h1 {
    margin: 1.5rem 0 0;
    max-width: 16ch;
    font-size: clamp(2.375rem, 1.2rem + 5.2vw, 4.75rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  h1 :global(.lp-grad) {
    background: var(--lp-title-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lp-tagline {
    margin: 1.25rem 0 0;
    max-width: 40rem;
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  .lp-install {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    width: min(100%, 42rem);
    margin-top: 2rem;
    padding: 0.35rem 0.35rem 0.35rem 1rem;
    border: 1px solid var(--lp-border);
    border-radius: 0.75rem;
    background: var(--lp-surface-strong);
  }
  .lp-install code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    text-align: start;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-1);
    background: none;
    padding: 0.5rem 0;
    scrollbar-width: none;
  }
  .lp-install-prompt {
    margin-inline-end: 0.75ch;
    color: var(--sl-color-text-accent);
    user-select: none;
  }
  .lp-copy {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .lp-copy:hover {
    background: var(--lp-surface);
    color: var(--sl-color-white);
  }
  .lp-copy :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    grid-area: 1 / 1;
  }
  .lp-copy :global(.lp-copy-done),
  .lp-copy[data-copied] :global(.lp-copy-idle) {
    visibility: hidden;
  }
  .lp-copy[data-copied] :global(.lp-copy-done) {
    visibility: visible;
    color: var(--lp-ok);
  }
  .lp-install-note {
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .lp-install-note code {
    font-family: var(--__sl-font-mono);
    font-size: 0.95em;
    background: none;
    padding: 0;
    color: var(--sl-color-gray-2);
  }

  .lp-hero .lp-actions {
    margin-top: 2rem;
  }
  .lp-term {
    width: min(100%, 50rem);
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

</style>
