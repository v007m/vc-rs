---
/** One card in the landing feature grid: the whole card links to the page that explains it. */
import LineIcon from './LineIcon.astro';
import type { IconName } from './icons';

interface Props {
  title: string;
  icon: IconName;
  href: string;
}

const { title, icon, href } = Astro.props;
---

<a class="lp-feature" href={href}>
  <span class="lp-feature-icon"><LineIcon name={icon} /></span>
  <span class="lp-feature-title">{title}<LineIcon name="arrow" class="lp-feature-arrow" /></span>
  <span class="lp-feature-body"><slot /></span>
</a>

<style>
  .lp-feature {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.4rem 1.4rem 1.5rem;
    border: 1px solid var(--lp-border);
    border-radius: 1rem;
    background: var(--lp-card);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }
  .lp-feature:hover,
  .lp-feature:focus-visible {
    border-color: var(--lp-accent-border);
    background: var(--lp-card-hover);
    box-shadow: 0 16px 40px -24px var(--lp-accent-shadow);
  }
  .lp-feature-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.4rem;
    border-radius: 0.7rem;
    background: var(--lp-icon-bg);
    color: var(--sl-color-text-accent);
    border: 1px solid var(--lp-accent-border);
  }
  .lp-feature-icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .lp-feature-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .lp-feature-title :global(.lp-feature-arrow) {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--sl-color-gray-3);
    transition:
      transform 0.2s,
      color 0.2s;
  }
  .lp-feature:hover :global(.lp-feature-arrow) {
    color: var(--sl-color-text-accent);
    transform: translateX(3px);
  }
  .lp-feature-body {
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
  .lp-feature-body :global(p) {
    margin: 0;
  }
  .lp-feature-body :global(code) {
    font-family: var(--__sl-font-mono);
    font-size: 0.9em;
    padding: 0.05em 0.3em;
    border-radius: 0.3em;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-gray-1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lp-feature:hover {
      transform: translateY(-2px);
    }
  }
</style>
