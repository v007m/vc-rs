---
/**
 * A screenshot from `mise run screenshots`, with a one-line caption. `src` names it without its theme:
 * `web/run` shows `web/run-light.webp` on the light theme and `web/run-dark.webp` on the dark one. A
 * picture taken in one theme only (the TUI draws its own colours) shows on both.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/**/*.webp', { eager: true });
const find = (theme: string) => images[`../assets/screenshots/${src}-${theme}.webp`]?.default;
const dark = find('dark');
const light = find('light');
if (!dark && !light) throw new Error(`no screenshot ${src}; run \`mise run screenshots\``);
/** Shown at half its pixel width: the pictures are taken at twice the device scale. */
const shown = (image: ImageMetadata) => ({ width: Math.round(image.width / 2), densities: [1, 2] });
---

<figure class="vc-shot">
  {
    light && dark ? (
      <>
        <Image src={light} alt={alt} class="dark:sl-hidden" {...shown(light)} />
        <Image src={dark} alt={alt} class="light:sl-hidden" {...shown(dark)} />
      </>
    ) : (
      <Image src={(light ?? dark)!} alt={alt} {...shown((light ?? dark)!)} />
    )
  }
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .vc-shot {
    margin-block: 1.5rem;
  }
  /* No `display` here: it would outrank Starlight's `light:sl-hidden` and `dark:sl-hidden`. */
  .vc-shot :global(img) {
    vertical-align: bottom;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
  }
  .vc-shot figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
