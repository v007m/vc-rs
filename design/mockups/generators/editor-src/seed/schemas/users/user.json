{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User",
  "type": "object",
  "required": ["id", "name", "email", "role"],
  "properties": {
    "id": { "type": "string", "pattern": "^usr_" },
    "name": { "type": "string", "minLength": 1 },
    "email": { "type": "string", "format": "email" },
    "role": { "enum": ["member", "admin"] },
    "active": { "type": "boolean" }
  }
}
